# ============================================================
# HTTP200.TI — Variáveis de ambiente (EXEMPLO)
# Copie para .env.local em dev ou configure na Vercel
# (Settings → Environment Variables → Production/Preview).
# NUNCA commite valores reais. O .gitignore já cobre .env*.
# ============================================================

# Obrigatório — segredo para assinar/verificar tokens JWT.
# A API FALHA ao iniciar se ausente (sem fallback hardcoded).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Credenciais do painel admin (login)
ADMIN_USER=
ADMIN_PASS=

# Supabase (project URL + anon key)
# A anon key é PÚBLICA (fica exposta) e, com o RLS do supabase-schema.sql,
# NÃO consegue escrever em servicos/conteudo/config (escrita restrita a service_role).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Obrigatório — service_role key do Supabase (Dashboard → Settings → API).
# Usada SOMENTE na API (backend) nas operações de escrita autenticadas.
# NUNCA exponha no frontend. A API FALHA ao iniciar se ausente
# (fail-closed, sem fallback para a anon key).
SERVICE_ROLE_KEY=

# Opcional — origens CORS adicionais, separadas por vírgula.
# Somam-se às origens padrão (GitHub Pages + Vercel + localhost).
# Ex.: CORS_ALLOWED_ORIGINS="https://staging.example.com,https://preview.example.com"
CORS_ALLOWED_ORIGINS=

# WhatsApp (opcional) — notificação de novo pedido para o dono da loja.
# Número no formato internacional sem + (ex: 5548988547455).
# Token obtido em https://www.callmebot.com/blog/callmebot-api-free-api-whatsapp/
WHATSAPP_OWNER_NUMBER=
WHATSAPP_NOTIFY_TOKEN=
