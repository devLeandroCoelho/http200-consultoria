# ============================================================
# HTTP200.TI — Variáveis de ambiente (EXEMPLO)
# Copie para .env.local em dev ou configure na Vercel
# (Settings → Environment Variables → Production/Preview).
# NUNCA commite valores reais. O .gitignore já cobre .env*.
# ============================================================

# Obrigatório — segredo para assinar/verificar tokens JWT.
# A API FALHA ao iniciar se ausente (sem fallback hardcoded).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Credenciais do painel admin (login)
ADMIN_USER=
ADMIN_PASS=

# Supabase (project URL + anon key)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional — origens CORS adicionais, separadas por vírgula.
# Somam-se às origens padrão (GitHub Pages + Vercel + localhost).
# Ex.: CORS_ALLOWED_ORIGINS="https://staging.example.com,https://preview.example.com"
CORS_ALLOWED_ORIGINS=
